<Project>

  <!-- Applies to every project in the solution (src/, tests/, tools/) - one version for the whole
       repo, since Tedide.App and Tedide.DocViewer ship together from here and there's no reason
       for their version numbers to drift apart. Surfaced in each app's Help > About dialog via
       Tedide.Theming's AppVersion, which reads it back from AssemblyInformationalVersionAttribute
       (auto-generated by the SDK from this Version property) rather than duplicating the number
       anywhere else. Bump this on every release. -->
  <PropertyGroup>
    <Version>0.8.0</Version>
  </PropertyGroup>

</Project>
