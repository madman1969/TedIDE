{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Tedide.slnx"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run Tedide.App",
      "type": "shell",
      "command": "wt.exe -w new dotnet run --project \"${workspaceFolder}\\src\\Tedide.App\\Tedide.App.csproj\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "run Tedide.DocViewer",
      "type": "shell",
      "command": "wt.exe -w new dotnet run --project \"${workspaceFolder}\\src\\Tedide.DocViewer\\Tedide.DocViewer.csproj\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      },
      "group": "test"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Tedide.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish Tedide.App (standalone exe)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/Tedide.App/Tedide.App.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained", "true",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-p:DebugType=none",
        "-p:EnableCompressionInSingleFile=true",
        "-p:InvariantGlobalization=true",
        "-o", "${workspaceFolder}/publish"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish Tedide.DocViewer (standalone exe)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/Tedide.DocViewer/Tedide.DocViewer.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained", "true",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-p:DebugType=none",
        "-p:EnableCompressionInSingleFile=true",
        "-p:InvariantGlobalization=true",
        "-o", "${workspaceFolder}/publish-docviewer"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
