<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tedide.Core\Tedide.Core.csproj" />
    <ProjectReference Include="..\Tedide.Build\Tedide.Build.csproj" />
    <ProjectReference Include="..\Tedide.Debug\Tedide.Debug.csproj" />
    <ProjectReference Include="..\Tedide.Theming\Tedide.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Decodes the embedded avatar.jpg into pixel data for AboutDialog's ImageView - Terminal.Gui
         deliberately has no image-decoding dependency of its own, so the caller supplies one.
         Windows-only, matching this app's existing platform assumption (see ViceEmulator, the
         run-tedide skill). -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\avatar.jpg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tedide.App.Tests" />
  </ItemGroup>

  <!-- opt6502.exe (Tedide's patched fork, GPL-3 - see tools/opt6502/TEDIDE.md) beside Tedide, which
       is the first place Cc65Toolchain looks for it. Only when it has been built with
       tools\opt6502\build.cmd - the binary isn't checked in, and a build without it is fine (opt6502
       is opt-in per project). Kept as a separate file, never bundled into the single-file exe: it's
       a separate GPL program that Tedide only starts as a process. The post-publish copy is the same
       workaround as Tedide.DocViewer.csproj's CopyDocsDbToPublishDir, for the same reason. -->
  <PropertyGroup>
    <Opt6502Exe>$(MSBuildThisFileDirectory)..\..\tools\opt6502\bin\opt6502.exe</Opt6502Exe>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(Opt6502Exe)')">
    <None Include="$(Opt6502Exe)" Link="opt6502.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="CopyOpt6502ToPublishDir" AfterTargets="Publish" Condition="Exists('$(Opt6502Exe)')">
    <Copy SourceFiles="$(Opt6502Exe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Terminal.Gui v2 is prerelease; it flags the static Application facade and TextView as
         obsolete in favor of an instance-based Application and a separate tui-cs/Editor package
         that aren't published yet. Suppress until those ship and this app migrates to them.
         CA1416 flags System.Drawing.Common's Windows-only APIs (AboutDialog's avatar decoding) as
         reachable on all platforms - this whole app already assumes Windows (see ViceEmulator, the
         run-tedide skill), so that's a non-issue here. -->
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>

</Project>
