<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Shared with Tedide.App - the same nine color themes and the same per-user settings.json,
         so this viewer opens in whatever theme was last selected in either app. -->
    <ProjectReference Include="..\Tedide.Theming\Tedide.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <!-- Reads Docs.db - see DocDatabase. Markdig (which Terminal.Gui.Views.Markdown itself depends
         on to parse/render Markdown) is pulled in transitively via the Terminal.Gui package above;
         no direct reference to it is needed here. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Decodes the embedded avatar.jpg into pixel data for AboutDialog's ImageView - Terminal.Gui
         deliberately has no image-decoding dependency of its own, so the caller supplies one. Same
         package/version as Tedide.App.csproj's AboutDialog, which this project otherwise has no
         dependency on. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\avatar.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every bundled page's Markdown - the cc65 manual (converted from https://cc65.github.io/doc/)
         and The C Book (converted from https://publications.gbdirect.co.uk/c_book/, bundled under
         its own free-redistribution license) - plus catalog metadata and a full-text search index,
         built once by tools/Cc65DocsDbBuilder from SourceHtml/*.html and SourceHtml/CBook/*.html
         there - see that project for the actual HTML-to-Markdown conversion and its own doc
         comments for why cross-references resolve to Markdown heading-slug anchors rather than
         each site's own original anchor names. A loose file copied next to the built exe (SQLite
         needs a real file path to open), not an embedded resource - re-run the builder tool and
         rebuild to pick up any change to it. CopyToOutputDirectory alone lands it next to the DLL
         under bin/ for a normal build, but the standalone-exe publish task (PublishSingleFile)
         composes its publish output differently and can drop loose content that isn't also marked
         CopyToPublishDirectory. Kept here for a normal (non-single-file) publish/build, but it's not
         sufficient on its own for the single-file task - see the CopyDocsDbToPublishDir target
         below, which is what that task actually depends on. -->
    <None Include="Docs.db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Belt-and-suspenders for the standalone-exe publish task (PublishSingleFile): even with
       CopyToPublishDirectory above, Docs.db was observed missing from the publish folder on a
       second, incremental `dotnet publish` run (present after a clean build, silently dropped on
       the next run without an intervening clean) - some part of single-file publish's incremental
       up-to-date check evidently doesn't durably track this loose content file as an expected
       output and prunes it. An explicit post-publish copy sidesteps that logic entirely instead of
       depending on it: SkipUnchangedFiles="false" means this always re-copies, so there's no
       incremental state to get out of sync with. -->
  <Target Name="CopyDocsDbToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Docs.db" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Terminal.Gui v2 is prerelease; it flags the static Application facade as obsolete in favor
         of an instance-based Application that isn't published yet - same suppression as
         Tedide.App.csproj, which this project otherwise has no dependency on.
         CA1416 flags System.Drawing.Common's Windows-only APIs (AboutDialog's avatar decoding) as
         reachable on all platforms - same suppression and same reasoning as Tedide.App.csproj,
         which ships as a win-x64 standalone exe (see the publish task in .vscode/tasks.json) same
         as this project does. -->
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>

</Project>
