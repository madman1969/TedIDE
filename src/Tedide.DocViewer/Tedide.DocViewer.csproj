<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Shared with Tedide.App - the same nine color themes and the same per-user settings.json,
         so this viewer opens in whatever theme was last selected in either app. -->
    <ProjectReference Include="..\Tedide.Theming\Tedide.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <!-- Reads Docs.db - see DocDatabase. Markdig (which Terminal.Gui.Views.Markdown itself depends
         on to parse/render Markdown) is pulled in transitively via the Terminal.Gui package above;
         no direct reference to it is needed here. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every bundled page's Markdown (converted from https://cc65.github.io/doc/'s HTML) plus its
         catalog metadata and a full-text search index, built once by tools/Cc65DocsDbBuilder from
         SourceHtml/*.html there - see that project for the actual HTML-to-Markdown conversion and
         its own doc comments for why cross-references resolve to Markdown heading-slug anchors
         rather than cc65's original anchor names. A loose file copied next to the built exe (SQLite
         needs a real file path to open), not an embedded resource - re-run the builder tool and
         rebuild to pick up any change to it. -->
    <None Include="Docs.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Terminal.Gui v2 is prerelease; it flags the static Application facade as obsolete in favor
         of an instance-based Application that isn't published yet - same suppression as
         Tedide.App.csproj, which this project otherwise has no dependency on. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

</Project>
