<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logging shared by Tedide.App and Tedide.DocViewer: the Serilog file setup (AppLog) and the
       [Log] aspect. The library projects (Core, Build, Debug, Git) deliberately don't reference
       this - they stay free of a logging dependency and report failures to their callers. -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Compile-time aspects (MIT). Flows to every project referencing this one, so [Log] is woven
         there too - and its small Metalama.Framework.dll redist ships beside each exe. -->
    <PackageReference Include="Metalama.Framework" Version="2026.1.30" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
