{
  "Name": "WorldMapPlus4",
  "Target": "Plus4",
  "OutputType": "Application",
  "ProjectReferences": [
    "..\\..\\FarMem\\FarMemPlus4\\FarMemPlus4.tproj"
  ],
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "EnableSuperCpu": false,
  "ViceArguments": [
    "-ramsize",
    "64",
    "-memoryexphack",
    "3"
  ],
  "UseOpt6502": true,
  "Opt6502Mode": "Speed",
  "SourceFiles": [
    "../src/screen_plus4.c",
    "../src/main.c",
    "../src/world.c",
    "../src/view.c",
    "../src/tiles.c",
    "../src/terrain.s",
    "../src/blit.s"
  ],
  "OutputFile": "bin/WorldMapPlus4.prg",
  "LinkerConfigPath": "plus4-worldmap.cfg",
  "IncludePaths": [
    "../include"
  ],
  "PreprocessorDefines": [],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}