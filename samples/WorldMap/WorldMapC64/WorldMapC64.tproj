{
  "Name": "WorldMapC64",
  "Target": "C64",
  "OutputType": "Application",
  "ProjectReferences": [
    "../../FarMem/FarMemC64/FarMemC64.tproj"
  ],
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "EnableSuperCpu": false,
  "ViceArguments": [
    "-reu",
    "-reusize",
    "512"
  ],
  "UseOpt6502": true,
  "Opt6502Mode": "Size",
  "SourceFiles": [
    "../src/main.c",
    "../src/world.c",
    "../src/view.c",
    "../src/tiles.c",
    "../src/screen_c64.c",
    "../src/terrain.s",
    "../src/blit.s"
  ],
  "OutputFile": "bin/WorldMapC64.prg",
  "LinkerConfigPath": "c64-worldmap.cfg",
  "IncludePaths": [
    "../include"
  ],
  "PreprocessorDefines": [],
  "ExtraArguments": [
    "-Cl"
  ],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}