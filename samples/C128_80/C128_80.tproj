{
  "Name": "C128_80",
  "Target": "C128",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "SourceFiles": [
    "src/main.c",
    "src/screen.c",
    "src/ruler.c",
    "src/columns.c",
    "src/contrast.c",
    "src/input.c"
  ],
  "OutputFile": "bin/C128_80.prg",
  "ExtraArguments": [
    "-I",
    "include"
  ]
}