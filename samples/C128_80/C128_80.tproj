    "src/ruler.c",
    "src/columns.c",
    "src/contrast.c",
    "src/input.c",
    "src/vdc.c",
    "src/colours.c",
    "src/attributes.c",
    "src/charset.c",
    "src/effects.c",
    "src/bitmap.c"
  ],
  "OutputFile": "bin/C128_80.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [
    "include"
  ],
  "PreprocessorDefines": [],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}