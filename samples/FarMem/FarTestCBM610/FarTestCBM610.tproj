{
  "Name": "FarTestCBM610",
  "Target": "Cbm610",
  "OutputType": "Application",
  "ProjectReferences": [
    "../FarMemCBM610/FarMemCBM610.tproj"
  ],
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "EnableSuperCpu": false,
  "ViceArguments": [
    "-ramsize",
    "256"
  ],
  "UseOpt6502": true,
  "Opt6502Mode": "Speed",
  "SourceFiles": [
    "../test/fartest.c"
  ],
  "OutputFile": "bin/FarTestCBM610.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [],
  "PreprocessorDefines": [
    "FAR_EXPECTED=FAR_CBMBANK"
  ],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}