{
  "Name": "FarTestC128REU",
  "Target": "C128",
  "OutputType": "Application",
  "ProjectReferences": [
    "../FarMemC128/FarMemC128.tproj"
  ],
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "EnableSuperCpu": false,
  "ViceArguments": [
    "-reu",
    "-reusize",
    "512"
  ],
  "UseOpt6502": true,
  "Opt6502Mode": "Speed",
  "SourceFiles": [
    "../test/fartest.c"
  ],
  "OutputFile": "bin/FarTestC128REU.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [],
  "PreprocessorDefines": [
    "FAR_EXPECTED=FAR_REU"
  ],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}