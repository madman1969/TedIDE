{
  "Name": "Plus4colours",
  "Target": "Plus4",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "ExportLabels": false,
  "SourceFiles": [
    "src/main.c"
  ],
  "OutputFile": "bin/Plus4colours.prg",
