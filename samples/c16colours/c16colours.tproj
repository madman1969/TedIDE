{
  "Name": "c16colours",
  "Target": "C16",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": false,
  "ExportLabels": false,
  "SourceFiles": [
    "src/main.c"
  ],
  "OutputFile": "bin/c16colours.prg",
  "ExtraArguments": [
    "-I",
    "include"
  ]
}