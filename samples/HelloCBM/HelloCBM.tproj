{
  "Name": "HelloCBM",
  "Target": "C64",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": false,
  "ExportLabels": false,
  "SourceFiles": [
    "src/main.c",
    "src/screen.c",
    "src/animation.c",
    "src/input.c",
    "src/delay.c",
    "src/border.s"
  ],
  "OutputFile": "bin/HelloCBM.prg",
  "IncludePaths": [
    "include"
  ],
  "ExtraArguments": []
}