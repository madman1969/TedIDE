    "src/main.c",
    "src/machine.c",
    "src/cpu.c",
    "src/memory.c",
    "src/video.c",
    "src/sound.c"
  ],
  "OutputFile": "bin/CBMInfo.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [
    "include"
  ],
  "PreprocessorDefines": [],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}