{
  "Name": "CBMInfo",
  "Target": "C64",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "SourceFiles": [
    "src/main.c",
    "src/machine.c",
    "src/cpu.c",
    "src/memory.c",
    "src/video.c",
    "src/sound.c"
  ],
  "OutputFile": "bin/CBMInfo.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [],
  "PreprocessorDefines": [],
  "ExtraArguments": [
    "-I",
    "include"
  ]
}