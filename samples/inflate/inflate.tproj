{
  "Name": "inflate",
  "Target": "Vic20",
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "ExportLabels": true,
  "SourceFiles": [
    "src/inflate.c"
  ],
  "OutputFile": "bin/inflate.prg",
  "ExtraArguments": [
    "-I",
    "include"
  ]
}