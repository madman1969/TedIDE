{
  "Name": "HelloPlus4",
  "Target": "Plus4",
  "OutputType": "Application",
  "ProjectReferences": [],
  "OptimizationLevel": "Maximum",
  "GenerateAssemblyListing": true,
  "AddSourceAsComment": true,
  "GenerateLinkerMap": true,
  "GenerateDebugInfo": true,
  "ExportLabels": true,
  "EnableSuperCpu": false,
  "UseOpt6502": true,
  "Opt6502Mode": "Speed",
  "SourceFiles": [
    "src/main.c",
    "src/screen.c",
    "src/palette.c",
    "src/sound.c",
    "src/speed.c",
    "src/input.c",
    "src/delay.c"
  ],
  "OutputFile": "bin/HelloPlus4.prg",
  "LinkerConfigPath": null,
  "IncludePaths": [
    "include"
  ],
  "PreprocessorDefines": [],
  "ExtraArguments": [],
  "PreBuildCommands": [],
  "PostBuildCommands": []
}