<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>opt6502</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The optimizer itself - this is only a command-line front end to Tedide.Build's
         Opt6502Optimizer, for scripts and the sim65 tests. -->
    <ProjectReference Include="..\..\src\Tedide.Build\Tedide.Build.csproj" />
  </ItemGroup>

</Project>
